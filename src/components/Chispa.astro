  <g stroke="currentColor" stroke-width={stroke} stroke-linecap="round">
    <line x1="256" y1="178.6" x2="256" y2="71.7"/><line x1="310.7" y1="201.3" x2="347.2" y2="164.8"/>
    <line x1="333.4" y1="256" x2="440.3" y2="256"/><line x1="310.7" y1="310.7" x2="347.2" y2="347.2"/>
    <line x1="256" y1="333.4" x2="256" y2="440.3"/><line x1="201.3" y1="310.7" x2="164.8" y2="347.2"/>
    <line x1="178.6" y1="256" x2="71.7" y2="256"/><line x1="201.3" y1="201.3" x2="164.8" y2="164.8"/>
  </g>
</svg>
