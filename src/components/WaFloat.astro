---
import { Icon } from 'astro-icon/components';
import { waHref } from '../site';
const message = 'Hola, te escribo desde la web de Traka. Quiero más información.';
---
<a class="wa-float" href={waHref(message)} data-wa="flotante" rel="noopener">
  <Icon name="ph:whatsapp-logo-fill" class="size-6 shrink-0" aria-hidden="true" />
  <span class="wa-float__text">¿Hablamos?</span>
</a>
