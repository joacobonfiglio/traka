---
import { Icon } from 'astro-icon/components';
/** Maqueta abstracta para las páginas de servicio: navegador + celular. */
interface Props { variant?: 'web' | 'mapa' | 'panel'; label?: string }
const { variant = 'web', label = 'tu negocio' } = Astro.props;
const alt = {
  web: 'Maqueta de una web mostrada en una computadora y en un celular.',
  mapa: 'Maqueta de una búsqueda en Google Maps con la ficha del negocio destacada.',
  panel: 'Maqueta de un panel de gestión en una computadora y en un celular.',
}[variant];
---
<div class="relative mx-auto w-full max-w-[520px] pb-10 pl-10 sm:pb-14 sm:pl-16" role="img" aria-label={alt}>
  <div class="win" aria-hidden="true">
    <div class="win__bar">
      <span class="win__dot"></span><span class="win__dot"></span><span class="win__dot"></span>
      <span class="win__addr">
        <Icon name="ph:lock-simple-bold" class="size-2.5 shrink-0" />
        {variant === 'mapa' ? 'maps · tu rubro cerca' : variant === 'panel' ? 'panel · tu negocio' : label}
      </span>
    </div>

    {variant === 'web' && (
      <div class="aspect-[16/10] p-4">
        <div class="flex h-[52%] flex-col justify-center rounded-xl bg-fuego px-4">
          <div class="ml-auto h-3 w-2/5 rounded bg-carbon/80"></div>
          <div class="ml-auto mt-2 h-3 w-1/4 rounded bg-carbon/60"></div>
          <div class="mt-4 flex items-center justify-end gap-2 pr-1">
            <span class="flex h-7 items-center gap-1.5 rounded-full bg-carbon px-3 text-[9px] font-medium text-arena">
              <Icon name="ph:whatsapp-logo-bold" class="size-3" />WhatsApp
            </span>
            <span class="h-7 w-16 rounded-full border-2 border-carbon/40"></span>
          </div>
        </div>
        <div class="mt-3 grid grid-cols-3 gap-3">
          <div class="h-14 rounded-lg bg-carbon/10"></div><div class="h-14 rounded-lg bg-carbon/10"></div><div class="h-14 rounded-lg bg-carbon/10"></div>
        </div>
      </div>
    )}

    {variant === 'mapa' && (
      <div class="relative aspect-[16/10] overflow-hidden bg-[#E8E3D7]">
        <svg class="absolute inset-0 size-full" viewBox="0 0 320 200" preserveAspectRatio="none">
          <g stroke="#FBF8F3" stroke-width="7" stroke-linecap="round">
            <path d="M-10,60 L160,48 L330,74" /><path d="M-10,140 L150,132 L330,150" />
            <path d="M70,-10 L84,210" /><path d="M215,-10 L228,210" />
          </g>
          <g fill="#D8D2C4"><rect x="12" y="76" width="44" height="46" rx="4"/><rect x="96" y="76" width="52" height="46" rx="4"/><rect x="240" y="80" width="48" height="42" rx="4"/><rect x="96" y="154" width="44" height="34" rx="4"/></g>
        </svg>
        <span class="absolute left-[44%] top-[34%] grid size-9 place-items-center rounded-full bg-fuego text-carbon shadow-lg">
          <Icon name="ph:map-pin-fill" class="size-5" />
        </span>
        <div class="absolute bottom-2 left-2 right-2 rounded-lg bg-white p-2.5 shadow-md">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <div class="h-2.5 w-24 rounded bg-carbon/80"></div>
              <div class="mt-1.5 flex items-center gap-1">
                <Icon name="ph:star-fill" class="size-2.5 text-chispa" /><Icon name="ph:star-fill" class="size-2.5 text-chispa" />
                <Icon name="ph:star-fill" class="size-2.5 text-chispa" /><Icon name="ph:star-fill" class="size-2.5 text-chispa" />
                <Icon name="ph:star-fill" class="size-2.5 text-chispa" />
                <span class="ml-1 h-2 w-12 rounded bg-carbon/25"></span>
              </div>
            </div>
            <span class="flex h-6 shrink-0 items-center gap-1 rounded-full bg-fuego px-2 text-[8px] font-medium text-carbon">
              <Icon name="ph:whatsapp-logo-bold" class="size-2.5" />Mensaje
            </span>
          </div>
        </div>
      </div>
    )}

    {variant === 'panel' && (
      <div class="flex aspect-[16/10] gap-2 p-3">
        <div class="hidden w-1/5 flex-col gap-1.5 rounded-lg bg-carbon/8 p-2 sm:flex">
          <div class="h-2 w-full rounded bg-carbon/25"></div>
          <div class="h-2 w-4/5 rounded bg-carbon/15"></div>
          <div class="h-2 w-3/5 rounded bg-carbon/15"></div>
          <div class="mt-auto h-2 w-2/3 rounded bg-carbon/15"></div>
        </div>
        <div class="flex-1">
          <div class="grid grid-cols-3 gap-2">
            {[0, 1, 2].map((i) => (
              <div class={`rounded-lg p-2 ${i === 0 ? 'bg-fuego' : 'bg-carbon/8'}`}>
                <div class={`h-1.5 w-2/3 rounded ${i === 0 ? 'bg-carbon/50' : 'bg-carbon/20'}`}></div>
                <div class={`mt-1.5 h-3 w-1/2 rounded ${i === 0 ? 'bg-carbon' : 'bg-carbon/40'}`}></div>
              </div>
            ))}
          </div>
          <div class="mt-2 flex h-[58%] items-end gap-1.5 rounded-lg bg-carbon/5 p-2">
            {[38, 55, 30, 72, 48, 88, 64].map((h) => (
              <span class="flex-1 rounded-t bg-brasa/70" style={`height:${h}%`}></span>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>

  <div class="phone absolute bottom-0 left-0 !w-[112px] !rounded-[22px] !border-[6px] sm:!w-[140px] sm:!rounded-[26px]" aria-hidden="true">
    <div class="flex h-full flex-col px-1.5 pb-1.5 pt-5">
      <div class={`flex h-[42%] flex-col justify-center rounded-md px-2 ${variant === 'panel' ? 'bg-mar' : 'bg-fuego'}`}>
        <div class="h-1.5 w-4/5 rounded bg-carbon/80"></div>
        <div class="mt-1 h-1.5 w-3/5 rounded bg-carbon/60"></div>
        <div class="mt-2 h-4 w-14 rounded-full bg-carbon"></div>
      </div>
      <div class="mt-1.5 grid gap-1.5">
        <div class="h-6 rounded bg-carbon/10"></div>
        <div class="h-6 rounded bg-carbon/10"></div>
      </div>
      <div class="mb-1 mt-auto h-5 rounded-full bg-[#25D366]/80"></div>
    </div>
  </div>
</div>
