---
interface Props { name: string; kind: string; tone: string; servicio?: string; url?: string; metric?: string }
const { name, kind, url, metric } = Astro.props;
const shots: Record<string, [string, string]> = {
  Aquabon: ['aquabon-home', 'Portada de Aquabon con sus servicios y el botón para consultar por WhatsApp'],
  'Tintorería Constitución': ['constitucion-home', 'Portada de Tintorería Constitución con retiro a domicilio'],
  Lavi: ['lavi-inicio', 'Panel de facturación, gastos y resultados de Lavi con datos de demostración'],
};
const [file, alt] = shots[name];
const src = `/proyectos/${file}.webp`;
---
<article class="case-shot" data-reveal>
  <a href={url || src} aria-label={url ? `Visitar ${name}` : 'Ampliar el panel de Lavi'}>
    <img src={src} alt={alt} width="1360" height="800" loading="lazy" />
  </a>
  <p class="meta mt-5 text-chispa">{kind}</p>
  <h3 class="mt-2 text-2xl">{name}</h3>
  {metric && <p>{metric}</p>}
  <a href={url || src} class="link mt-3 inline-block text-sm">{url ? 'Visitar sitio ↗' : 'Ampliar panel de ejemplo ↗'}</a>
</article>
<style>
.case-shot{min-width:0;width:min(82vw,360px)}
.case-shot img{display:block;width:100%;height:auto;border-radius:10px;border:1px solid rgb(255 255 255 / 20%);box-shadow:0 8px 24px #0002}
@media(min-width:1024px){.case-shot{width:auto}}
</style>
