---
import { guideVisual, guideTopic } from '../guide-visuals';
const { guide, eager = false } = Astro.props;
const d = guide.data;
const cover = guideVisual(d.servicio, guide.id);
---
<article class="reading-card">
  <a href={`/guias/${guide.id}/`}>
    <div class="reading-card__image">
      <img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <div class="reading-card__body">
      <p class="reading-card__meta"><span>{guideTopic(d.servicio)}</span><span>{d.lectura} min</span></p>
      <h3>{d.h1}</h3>
      <p class="reading-card__summary">{d.resumen}</p>
      <span class="reading-card__link">Leer guía</span>
    </div>
  </a>
</article>
<style>
.reading-card { height:100%; background:#fff; border:1px solid #ded7ce; border-radius:20px; overflow:hidden; transition:border-color .2s,box-shadow .2s; }
.reading-card:hover { border-color:#b94014; box-shadow:0 10px 25px #241e1910; }
a { display:flex; flex-direction:column; height:100%; color:inherit; text-decoration:none; }
a:focus-visible { outline:3px solid #b94014; outline-offset:-4px; }
.reading-card__image { aspect-ratio:1.6; overflow:hidden; background:#e9efea; border-bottom:1px solid #ded7ce; }
img { width:100%; height:100%; object-fit:cover; object-position:top; display:block; }
.reading-card__body { padding:1.4rem; display:flex; flex:1; flex-direction:column; }
.reading-card__meta { display:flex; justify-content:space-between; gap:.8rem; font-size:.875rem; color:#8b351b; font-weight:600; }
h3 { margin-top:.8rem; font-size:clamp(1.25rem,1rem + .5vw,1.6rem); line-height:1.2; }
.reading-card__summary { margin-top:.8rem; font-size:1rem; line-height:1.6; color:#62574f; }
.reading-card__link { padding-top:1.5rem; margin-top:auto; font-size:.95rem; font-weight:700; text-decoration:underline; text-underline-offset:4px; }
</style>
