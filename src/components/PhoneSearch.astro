---
import { Icon } from 'astro-icon/components';
import Chispa from './Chispa.astro';
---
<div class="relative mx-auto w-full max-w-[290px]">
  <div class="phone" role="img" aria-label="Ilustración: una búsqueda en Google de «tintorería cerca de mí» donde el primer resultado tiene botón de WhatsApp.">
    <div class="flex h-full flex-col px-3 pb-3 pt-9" aria-hidden="true">
      <div class="flex items-center gap-2 rounded-full border border-carbon/15 bg-white px-3 py-2.5 shadow-sm">
        <Icon name="ph:magnifying-glass-bold" class="size-4 shrink-0 text-ceniza" />
        <span class="font-mono text-[12px] leading-none"><span class="q-type">tintorería cerca de mí</span><span class="caret"></span></span>
      </div>
      <p class="label mt-3 text-[9px] text-ceniza">Resultados cerca tuyo</p>
      <div class="mt-2 flex flex-1 flex-col gap-2.5">
        <div class="result result--lit rounded-2xl border-2 border-carbon/10 bg-white p-3" style="--d:2.8s">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="text-[13px] font-bold leading-tight">Tu negocio</p>
              <p class="mt-0.5 text-[11px] text-ceniza">★★★★★ · Abierto ahora</p>
            </div>
            <Chispa class="size-5 shrink-0 text-fuego" stroke={50} />
          </div>
          <div class="wa-chip mt-2.5 flex gap-2">
            <span class="inline-flex min-h-8 flex-1 items-center justify-center gap-1.5 rounded-full bg-fuego px-3 text-[12px] font-medium text-carbon"><Icon name="ph:whatsapp-logo-bold" class="size-3.5" />WhatsApp</span>
            <span class="inline-flex min-h-8 items-center justify-center rounded-full border border-carbon/25 px-3 text-[12px]">Llamar</span>
          </div>
        </div>
        <div class="result rounded-2xl border-2 border-carbon/10 bg-white/60 p-3" style="--d:3.1s">
          <p class="text-[13px] font-bold leading-tight text-carbon/60">Otro negocio</p>
          <p class="mt-0.5 text-[11px] text-ceniza">Sin web</p>
        </div>
        <div class="result rounded-2xl border-2 border-carbon/10 bg-white/60 p-3" style="--d:3.35s">
          <p class="text-[13px] font-bold leading-tight text-carbon/60">Otro más</p>
          <p class="mt-0.5 text-[11px] text-ceniza">Sin horarios</p>
        </div>
      </div>
    </div>
  </div>
</div>
