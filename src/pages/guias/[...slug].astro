---
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { guideVisual, guideTopic } from '../../guide-visuals';
import FinalCta from '../../components/FinalCta.astro';
import Burn from '../../components/Burn.astro';
import { SITE_URL, site } from '../../site';

export async function getStaticPaths() {
  const guias = await getCollection('guias');
  return guias.map((g) => ({ params: { slug: g.id }, props: { g, todas: guias } }));
}

const { g, todas } = Astro.props;
const { Content, headings } = await render(g);
const d = g.data;
const cover = guideVisual(d.servicio, g.id);
// Primero las del mismo clúster: así el peso se queda en el servicio y no se
// dispersa. Si el clúster no alcanza, se completa con el resto.
const resto = todas.filter((x) => x.id !== g.id);
const mismoClúster = resto.filter((x) => x.data.servicio && x.data.servicio === d.servicio);
const otras = [...mismoClúster, ...resto.filter((x) => !mismoClúster.includes(x))].slice(0, 2);
const url = `${SITE_URL}/guias/${g.id}/`;
const fmt = (date: Date) => new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
const indice = headings.filter((h) => h.depth === 2);
const palabras = g.body?.split(/\s+/).filter(Boolean).length ?? 0;
const ogUrl = `${SITE_URL}/og/guia-${g.id}.png`;

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Guías', item: `${SITE_URL}/guias/` },
    { '@type': 'ListItem', position: 3, name: d.h1, item: url },
  ] },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.h1,
    description: d.description,
    datePublished: d.fecha.toISOString(),
    dateModified: (d.actualizada ?? d.fecha).toISOString(),
    author: { '@id': `${SITE_URL}/#org` },
    publisher: { '@id': `${SITE_URL}/#org` },
    mainEntityOfPage: url,
    inLanguage: 'es-AR',
    image: ogUrl,
    wordCount: palabras,
    timeRequired: `PT${d.lectura}M`,
    articleSection: d.kicker,
    ...(d.temas.length ? { keywords: d.temas.join(', ') } : {}),
    about: site.description,
  },
  ...(d.faqs.length
    ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
    : []),
];
---
<Base title={d.title} description={d.description} path={`/guias/${g.id}/`} jsonLd={jsonLd} ogSlug={`guia-${g.id}`}>
  <div class="lectura" aria-hidden="true"><i></i></div>

  <article class="guide-article s-papel on-light">
    <header class="article-header">
      <nav aria-label="Migas de pan" class="article-breadcrumb"><a href="/guias/">Todas las guías</a> / <span aria-current="page">{guideTopic(d.servicio)}</span></nav>
      <p class="label text-brasa">{guideTopic(d.servicio)} · {d.lectura} min de lectura</p>
      <h1>{d.h1}</h1>
      <p class="article-deck">{d.resumen}</p>
      <figure class="article-cover">
        <img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading="eager" decoding="async" fetchpriority="high" />
        <figcaption>{cover.caption}</figcaption>
      </figure>
    </header>
    <div class="article-reading">
      {indice.length > 1 && <details class="article-index">
        <summary>En esta guía <span>{indice.length} apartados</span></summary>
        <nav aria-label="Índice de la guía"><ol>{indice.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
      </details>}
      <div class="prosa"><Content /></div>
      {d.faqs.length > 0 && <section class="article-faq" aria-labelledby="gfaq-title">
        <h2 id="gfaq-title">Preguntas frecuentes</h2>
        <div class="mt-6 divide-y divide-current/15 border-y border-current/15">
          {d.faqs.map(f=><details class="faq group py-1">
            <summary class="flex items-center justify-between gap-6 py-4 font-display text-lg font-bold"><span>{f.q}</span><Icon name="ph:plus-bold" class="faq__plus size-5 shrink-0 text-fuego" aria-hidden="true" /></summary>
            <p class="pb-5 opacity-80">{f.a}</p>
          </details>)}
        </div>
      </section>}
      <p class="article-date">Publicado el {fmt(d.fecha)}{d.actualizada && ` · Actualizado el ${fmt(d.actualizada)}`}</p>
      <a href="/guias/" class="link">Explorar otras guías</a>
    </div>
  </article>

  {otras.length > 0 && (
    <section class="section s-arena on-light" aria-labelledby="otras-title">
      <div class="wrap">
        <h2 id="otras-title" class="h-lg">Seguí leyendo.</h2>
        <ul class="mt-10 grid gap-6 md:grid-cols-2">
          {otras.map(o => <li><GuideCard guide={o} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <div class="s-arena"><Burn to="fuego" /></div>
  <FinalCta message={`Hola, leí la guía "${d.h1}" y quiero que lo veamos juntos.`} origin={`cta-final-guia-${g.id}`} />
</Base>

<style is:global>
.prosa .guide-figure { margin: 2.5rem 0; }
.prosa .guide-figure a { display: block; border-radius: 16px; overflow: hidden; border: 1px solid rgb(30 23 18 / .14); }
.prosa .guide-figure img { display: block; width: 100%; height: auto; margin: 0; }
.prosa .guide-figure figcaption { margin-top: .75rem; font-size: .875rem; line-height: 1.6; color: #62584e; }
</style>

<style>
.guide-article { padding:2rem 1.25rem 4rem; }
.article-header { max-width:960px; margin:0 auto; }
.article-breadcrumb { font-size:.875rem; color:#62574f; margin-bottom:2rem; }
.article-breadcrumb a { text-decoration:underline; text-underline-offset:3px; }
.article-header h1 { max-width:850px; margin-top:1rem; font-size:clamp(2.1rem,4.4vw,3.8rem); line-height:1.08; letter-spacing:-.035em; }
.article-deck { max-width:760px; margin-top:1.3rem; font-size:1.15rem; line-height:1.7; color:#62574f; }
.article-cover { margin:2rem 0 2.5rem; }
.article-cover img { display:block; width:100%; max-height:540px; object-fit:contain; background:#eee9e1; border-radius:18px; border:1px solid #ded7ce; }
.article-cover figcaption { font-size:.875rem; line-height:1.5; color:#62574f; margin-top:.7rem; }
.article-reading { max-width:740px; margin:0 auto; }
.article-index { margin-bottom:2rem; border-block:1px solid #d8cfc5; padding:1rem 0; }
.article-index summary { cursor:pointer; font-weight:600; font-size:1rem; }
.article-index summary span { margin-left:.75rem; color:#62574f; font-size:.875rem; font-weight:400; }
.article-index ol { padding:1rem 0 .5rem 1.4rem; list-style:decimal; }
.article-index li { padding:.35rem 0; line-height:1.5; }
.article-index a { text-decoration:underline; text-underline-offset:3px; }
.article-faq { margin-top:3.5rem; }
.article-faq h2 { font-size:1.8rem; }
.article-date { margin:2.5rem 0 1rem; color:#62574f; font-size:.875rem; }
@media(max-width:600px){.article-cover{margin:1.5rem 0;}.article-cover img{border-radius:12px;}.article-deck{font-size:1.05rem;}.guide-article{padding-top:1.5rem;}}
</style>
