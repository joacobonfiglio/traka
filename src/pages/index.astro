---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Mecha from '../components/Mecha.astro';
import Burn from '../components/Burn.astro';
import Chispa from '../components/Chispa.astro';
import SectionHead from '../components/SectionHead.astro';
import WaButton from '../components/WaButton.astro';
import PhoneSearch from '../components/PhoneSearch.astro';
import Needs from '../components/Needs.astro';
import CaseCard from '../components/CaseCard.astro';
import Servicios from '../components/Servicios.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { getCollection } from 'astro:content';
import { cases, faqs, pasos, servicios, notaPrecios, SITE_URL } from '../site';

const servicioDe = (id: string) => servicios.find((s) => s.id === id)!;

const guias = (await getCollection('guias')).sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()).slice(0, 2);

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Servicios de Traka', itemListElement: servicios.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${SITE_URL}/#${s.id}` })) },
  ...servicios.map((s) => ({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    description: s.summary,
    provider: { '@id': `${SITE_URL}/#org` },
    areaServed: ['AR', 'ES'],
    url: `${SITE_URL}/#${s.id}`,
  })),
];
---
<Base
  title="Webs y posicionamiento en Google para negocios | Traka"
  description="Webs desde $200.000 y Perfil de Empresa en Google para comercios y pymes. Precio por escrito y una persona que te responde por WhatsApp."
  path="/"
  jsonLd={jsonLd}
>
  <Mecha>
    <!-- 1 · HERO -->
    <section id="hero" class="section s-papel on-light relative overflow-hidden pb-14 pt-10 md:pt-16" aria-labelledby="hero-title">
      <span class="node" aria-hidden="true"></span>
      <div class="glow glow--fuego left-[-16%] top-[-18%] size-[40rem]" aria-hidden="true"></div>
      <div class="glow glow--chispa right-[-8%] top-[34%] size-[26rem]" aria-hidden="true"></div>

      <div class="wrap relative grid items-center gap-12 lg:grid-cols-[1.15fr_.85fr]">
        <div>
          <p class="label flex items-center gap-2.5">
            <span class="pulse-dot" aria-hidden="true"></span>Webs y Google para negocios reales
          </p>
          <h1 id="hero-title" class="h-hero mt-6 font-display font-extrabold">
            <span class="hero__line" style="--d:.05s"><span>Que te</span></span>
            <span class="hero__line" style="--d:.16s"><span class="text-brasa">encuentren</span></span>
            <span class="hero__line" style="--d:.27s"><span>en Google<Chispa class="hero__spark ml-3 inline-block size-[.34em] -translate-y-[.38em] text-fuego" stroke={46} /></span></span>
          </h1>
          <p class="lede mt-8 max-w-xl text-carbon/80">
            Armamos tu Perfil de Empresa en Google y una web clara para el celular. El objetivo no son las visitas: son los mensajes.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <WaButton message="Hola, quiero una web para mi negocio. Vi que arrancan en $200.000." label="Quiero mi web" origin="hero" size="lg" />
            <a href="#servicios" class="btn btn-ghost btn-lg">Ver precios</a>
          </div>

          <ul class="hairline mt-10 grid max-w-2xl gap-x-8 gap-y-4 pt-7 sm:grid-cols-3">
            {[
              { k: 'Webs', v: 'Desde $200.000' },
              { k: 'Plazos', v: 'Por escrito' },
              { k: 'Quién atiende', v: 'Una persona' },
            ].map((s) => (
              <li>
                <p class="label">{s.k}</p>
                <p class="mt-1 font-display text-xl font-bold md:text-2xl">{s.v}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:rotate-[2.5deg]"><PhoneSearch /></div>
      </div>
    </section>

    <!-- 2 · SELECTOR -->
    <section id="que-necesitas" class="section s-arena on-light" aria-labelledby="need-title">
      <span class="node" aria-hidden="true"></span>
      <div class="wrap">
        <SectionHead
          kicker="Empezá por acá"
          id="need-title"
          title="¿Qué necesitás?"
          lede="Tocá tu caso y te mostramos el mensaje de WhatsApp ya escrito. Lo leés antes de enviarlo: si no te cierra, lo cambiás."
        />
        <div class="mt-10"><Needs /></div>
      </div>
    </section>

    <div class="s-arena"><Burn to="carbon" /></div>

    <!-- 3 · TRES ACTOS -->
    <section id="mecha" class="section s-carbon" aria-labelledby="acts-title">
      <span class="node" aria-hidden="true"></span>
      <div class="wrap">
        <SectionHead
          kicker="Cómo funciona"
          id="acts-title"
          title="Un cliente, tres pasos."
          lede="Cada paso enciende al siguiente, y cada uno tiene su servicio. Si uno falla, la mecha se corta: por eso los trabajamos los tres."
        />
      </div>
      <div class="wrap mt-12">
        <div class="snap-row snap-row--acts acts-row" data-scrollx tabindex="0" role="group" aria-label="Los tres pasos, deslizá para ver más">
          {pasos.map((a) => {
            const sv = servicioDe(a.servicio);
            return (
              <a class="act act--link" href={sv.page} data-reveal>
                <div class="flex items-center justify-between gap-4">
                  <span class="act__num label">{a.n} · {sv.name}</span>
                  <Icon name={a.icon} class="size-9 shrink-0 text-chispa" aria-hidden="true" />
                </div>
                <h3 class="mt-8 font-display text-4xl font-extrabold md:text-5xl" style="font-variation-settings:'opsz' 96">{a.t}</h3>
                <p class="mt-4 text-lg opacity-85">{a.d}</p>
                <ul class="mt-auto flex flex-wrap gap-2 pt-8">
                  {a.tags.map((t) => <li class="meta rounded-full border border-chispa/50 px-3 py-1.5 text-chispa">{t}</li>)}
                </ul>
                <span class="act__cta">{sv.price} · Ver el servicio<Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" /></span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <div class="s-carbon"><Burn to="papel" /></div>

    <!-- 4 · SERVICIOS Y PRECIOS -->
    <section id="servicios" class="section s-papel on-light" aria-labelledby="svc-title">
      <span class="node" aria-hidden="true"></span>
      <div class="wrap">
        <SectionHead
          kicker="Servicios y precios"
          id="svc-title"
          title="Lo que hacemos, con el precio a la vista."
          lede="Sabés desde dónde arranca cada cosa antes de escribirnos. Nada de pedir presupuesto para enterarte."
        />
        <div class="mt-12"><Servicios /></div>
        <p class="mt-8 text-sm opacity-75">{notaPrecios}</p>
      </div>
    </section>

    <div class="s-papel"><Burn to="mar" /></div>

    <!-- 5 · CASOS -->
    <section id="casos" class="section s-mar" aria-labelledby="casos-title">
      <span class="node" aria-hidden="true"></span>
      <div class="wrap">
        <SectionHead kicker="Proyectos" id="casos-title" title="Negocios reales, vistos como los ve tu cliente." />
        <div class="snap-row snap-row--cases mt-12" data-scrollx tabindex="0" role="group" aria-label="Casos de clientes, deslizá para ver más">
          {cases.map((c) => <CaseCard name={c.name} kind={c.kind} tone={c.tone} servicio={c.servicio} url={c.url} metric={c.metric} />)}
        </div>
      </div>
    </section>

    <div class="s-mar"><Burn to="arena" /></div>

    <!-- 6 · PROCESO -->
    <section id="proceso" class="section s-arena on-light" aria-labelledby="proc-title">
      <span class="node" aria-hidden="true"></span>
      <div class="wrap">
        <SectionHead kicker="Cómo trabajamos" id="proc-title" title="De la charla a las consultas, en cuatro pasos." />
        <div class="mt-12"><Process /></div>
      </div>
    </section>

    <!-- 7 · SIN VUELTAS -->
    <section id="sin-vueltas" class="section s-papel on-light" aria-labelledby="sv-title">
      <span class="node" aria-hidden="true"></span>
      <div class="wrap grid gap-12 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
        <div>
          <SectionHead kicker="Sin vueltas" id="sv-title" title="Lo que prometemos es lo que podemos cumplir." />
          <ul class="mt-10 space-y-5">
            {['Precio a la vista.', 'Plazos por escrito.', 'Una persona que responde.', 'Resultados medidos en consultas, no en likes.'].map((t, i) => (
              <li class="flex items-center gap-4 border-b border-carbon/15 pb-5 font-display text-2xl font-bold md:text-3xl" data-reveal style={`--d:${i * 80}ms`}>
                <Chispa class="size-7 shrink-0 text-fuego" stroke={50} />{t}
              </li>
            ))}
          </ul>
        </div>
        <blockquote class="relative overflow-hidden rounded-[32px] bg-chispa p-8 text-carbon md:p-12" data-reveal>
          <Chispa class="pointer-events-none absolute -right-10 -top-10 size-44 text-carbon/10" stroke={30} />
          <p class="relative font-display text-3xl font-extrabold leading-tight md:text-4xl">
            No prometemos el primer puesto en Google. Sí que te encuentren más, y te lo mostramos con datos.
          </p>
        </blockquote>
      </div>
    </section>

    <!-- 8 · PREGUNTAS -->
    <section id="preguntas" class="section s-arena on-light" aria-labelledby="faq-title">
      <span class="node" aria-hidden="true"></span>
      <div class="wrap wrap-narrow">
        <SectionHead kicker="Preguntas frecuentes" id="faq-title" title="Lo que casi todos preguntan." />
        <div class="mt-10"><Faq /></div>
        <p class="mt-10">
          ¿Querés saber de dónde venimos? <a class="link" href="/sobre-nosotros/">Conocé Traka</a>.
        </p>
      </div>
    </section>

    <!-- 9 · GUÍAS -->
    <section id="guias" class="section s-papel on-light" aria-labelledby="guias-title">
      <span class="node" aria-hidden="true"></span>
      <div class="wrap">
        <SectionHead
          kicker="Guías"
          id="guias-title"
          title="Si lo querés hacer vos, te contamos cómo."
          lede="Lo que sabemos, escrito sin tecnicismos. Si después preferís que lo hagamos nosotros, ya sabés dónde estamos."
        />
        <ul class="mt-12 grid gap-6 md:grid-cols-2">
          {guias.map((g, i) => (
            <li class="guia-card" data-reveal style={`--d:${i * 80}ms`}>
              <a href={`/guias/${g.id}/`} class="guia-card__link">
                <p class="label text-brasa">{g.data.kicker}</p>
                <h3 class="mt-4 font-display text-2xl font-extrabold leading-tight md:text-3xl">{g.data.h1}</h3>
                <p class="mt-3 opacity-80">{g.data.resumen}</p>
                <span class="guia-card__cta">Leer la guía<Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" /></span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-8"><a class="link font-medium" href="/guias/">Ver todas las guías</a></p>
      </div>
    </section>

    <div class="s-papel"><Burn to="fuego" /></div>
  </Mecha>

  <FinalCta message="Hola, quiero empezar con Traka. Te cuento de mi negocio: " origin="cta-final-home" />
</Base>
