{
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    { "source": "/servicios", "destination": "/#servicios", "permanent": true },
    { "source": "/servicios/", "destination": "/#servicios", "permanent": true }
  ],
  "headers": [
    {
      "source": "/propuestas/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
